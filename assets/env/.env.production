# Production stores (--dart-define=ENV=production).
# Remplacez APP_DOWNLOAD_LINK_IOS par l'URL App Store définitive une fois l'app publiée.
# SENTRY_DSN : DSN Sentry pour le monitoring d'erreurs. En CI Codemagic, préférer
# --dart-define=SENTRY_DSN=… (variable d'environnement SENTRY_DSN dans basic-env).
# Laisser vide en local si Sentry n'est pas configuré.
API_URL=https://api.tontine.devcoorp.net
WS_URL=wss://api.tontine.devcoorp.net
APP_DOWNLOAD_LINK_IOS=https://apps.apple.com/app/id000000000
APP_DOWNLOAD_LINK_ANDROID=https://play.google.com/store/apps/details?id=fr.devcoorp.tontine_v2
APP_DOWNLOAD_LINK_WEB=https://devcoorp.net
SENTRY_DSN=
